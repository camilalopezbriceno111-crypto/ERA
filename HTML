<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roble Academy | Contact</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <div class="logo">
        <h1>ROBLE ACADEMY</h1>
        <p>Excellence • Character • Community</p>
    </div>

    <nav>
        <a href="index.html">ABOUT US</a>
        <a href="history.html">HISTORY</a>
        <a href="achievements.html">ACHIEVEMENTS</a>
        <a href="campus.html">CAMPUS</a>
        <a href="contact.html" class="active">CONTACT</a>
    </nav>
</header>

<main>

    <section class="page-header">
        <p class="small-title">GET IN TOUCH</p>
        <h2>Contact</h2>
        <p>
            We would be happy to hear from you.
        </p>
    </section>

    <section class="content contact-section">

        <div class="contact-info">

            <h3>Contact Information</h3>

            <p>
                <strong>Address</strong><br>
                Roble Academy
            </p>

            <p>
                <strong>Phone</strong><br>
                +504 0000-0000
            </p>

            <p>
                <strong>Email</strong><br>
                info@robleacademy.edu
            </p>

            <p>
                <strong>Office Hours</strong><br>
                Monday - Friday
            </p>

        </div>

        <form>

            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name">

            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Your email">

            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6"
                placeholder="Write your message"></textarea>

            <button type="submit">SEND MESSAGE</button>

        </form>

    </section>

</main>

<footer>
    <p>© 2026 Roble Academy. All Rights Reserved.</p>
</footer>

</body>
</html>
